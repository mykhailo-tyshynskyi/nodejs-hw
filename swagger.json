{
  "openapi": "3.0.0",
  "info": {
    "title": "nodejs-hw API",
    "description": "Express.js Notes API with email/password authentication, session-based auth via HTTP-only cookies, note CRUD with tags and pagination, and avatar image uploads to Cloudinary.",
    "version": "1.0.0",
    "contact": {
      "name": "Mykhailo Tyshynskyi",
      "email": "tihan.cs@gmail.com"
    },
    "license": {
      "name": "ISC"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registration, login, session refresh/logout and password reset"
    },
    {
      "name": "Notes",
      "description": "Notes CRUD (all endpoints require session authentication)"
    },
    {
      "name": "Users",
      "description": "User profile management (requires session authentication)"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "Session-based authentication. The `accessToken` cookie must be sent together with the `sessionId` cookie. Both are set by /auth/register and /auth/login and are HTTP-only."
      }
    },
    "parameters": {
      "noteIdPath": {
        "name": "noteId",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId of the note",
        "schema": {
          "$ref": "#/components/schemas/NoteId"
        }
      },
      "searchQuery": {
        "name": "search",
        "in": "query",
        "required": false,
        "description": "Case-insensitive search across note title and content",
        "schema": {
          "$ref": "#/components/schemas/GetAllNotesSearch"
        }
      },
      "tagQuery": {
        "name": "tag",
        "in": "query",
        "required": false,
        "description": "Filter notes by exact tag",
        "schema": {
          "$ref": "#/components/schemas/GetAllNotesTag"
        }
      },
      "pageQuery": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/GetAllNotesPage"
        }
      },
      "perPageQuery": {
        "name": "perPage",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/GetAllNotesPerPage"
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["_id", "email", "avatar", "createdAt", "updatedAt"],
        "properties": {
          "_id": {
            "type": "string",
            "description": "User ID (MongoDB ObjectId)"
          },
          "username": {
            "type": "string",
            "description": "Defaults to the user's email when not provided"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "avatar": {
            "type": "string",
            "format": "uri",
            "default": "https://ac.goit.global/fullstack/react/default-avatar.jpg"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Note": {
        "type": "object",
        "required": [
          "_id",
          "title",
          "content",
          "tag",
          "userId",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "Note ID (MongoDB ObjectId)"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "default": ""
          },
          "tag": {
            "$ref": "#/components/schemas/Tag"
          },
          "userId": {
            "type": "string",
            "description": "Owner user ID (MongoDB ObjectId)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Tag": {
        "type": "string",
        "description": "Note tag",
        "enum": [
          "Work",
          "Personal",
          "Meeting",
          "Shopping",
          "Ideas",
          "Travel",
          "Finance",
          "Health",
          "Important",
          "Todo"
        ]
      },
      "NoteId": {
        "type": "string",
        "description": "MongoDB ObjectId (24 hexadecimal characters)",
        "pattern": "^[0-9a-fA-F]{24}$"
      },
      "RegisterUserInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "LoginUserInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RequestResetEmailInput": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ResetPasswordInput": {
        "type": "object",
        "required": ["password", "token"],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 8
          },
          "token": {
            "type": "string",
            "description": "JWT reset token received in the reset email"
          }
        }
      },
      "GetAllNotesSearch": {
        "type": "string"
      },
      "GetAllNotesTag": {
        "type": "string",
        "enum": [
          "Work",
          "Personal",
          "Meeting",
          "Shopping",
          "Ideas",
          "Travel",
          "Finance",
          "Health",
          "Important",
          "Todo"
        ]
      },
      "GetAllNotesPage": {
        "type": "integer",
        "minimum": 1,
        "default": 1
      },
      "GetAllNotesPerPage": {
        "type": "integer",
        "minimum": 5,
        "maximum": 20,
        "default": 10
      },
      "CreateNoteInput": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "description": "May be an empty string"
          },
          "tag": {
            "$ref": "#/components/schemas/Tag"
          }
        }
      },
      "UpdateNoteInput": {
        "type": "object",
        "minProperties": 1,
        "description": "At least one property must be provided",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "description": "May be an empty string"
          },
          "tag": {
            "$ref": "#/components/schemas/Tag"
          }
        }
      },
      "NotesPage": {
        "type": "object",
        "required": [
          "page",
          "perPage",
          "totalNotes",
          "totalPages",
          "notes"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "perPage": {
            "type": "integer"
          },
          "totalNotes": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Note"
            }
          }
        }
      },
      "AvatarResponse": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "description": "Returned by celebrate when request validation fails",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "ValidationError: \"password\" length must be at least 8 characters long"
          },
          "validation": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "example": "body"
              },
              "keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new user",
        "description": "Creates a new user account, hashes the password, creates a session and sets the sessionId, accessToken and refreshToken cookies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "headers": {
              "Set-Cookie": {
                "description": "Sets sessionId, accessToken and refreshToken cookies",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["user"],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Email already in use or request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ValidationErrorResponse"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "description": "Authenticates the user against the stored bcrypt hash, removes any previous session, creates a new one and sets the session cookies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "headers": {
              "Set-Cookie": {
                "description": "Sets sessionId, accessToken and refreshToken cookies",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh session",
        "description": "Validates the sessionId and refreshToken cookies, deletes the old session and issues a fresh one. Sessions and cookies are cleared when the refresh token has expired.",
        "responses": {
          "200": {
            "description": "Session refreshed",
            "headers": {
              "Set-Cookie": {
                "description": "Sets new sessionId, accessToken and refreshToken cookies",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing session credentials, session not found or refresh token expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout user",
        "description": "Deletes the current session (if any) and clears the sessionId, accessToken and refreshToken cookies.",
        "responses": {
          "204": {
            "description": "Logout successful (no content)",
            "headers": {
              "Set-Cookie": {
                "description": "Clears session cookies",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/request-reset-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request password reset email",
        "description": "Sends a password reset link to the email if the account exists. Always responds with 200 to avoid user enumeration.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestResetEmailInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset email sent (or user does not exist)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to send the email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Reset password",
        "description": "Verifies the JWT reset token, hashes the new password, updates the user and invalidates all existing sessions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/notes": {
      "get": {
        "tags": ["Notes"],
        "summary": "Get all notes for current user",
        "description": "Returns a paginated list of notes owned by the authenticated user, optionally filtered by a case-insensitive search term and/or tag.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/searchQuery"
          },
          {
            "$ref": "#/components/parameters/tagQuery"
          },
          {
            "$ref": "#/components/parameters/pageQuery"
          },
          {
            "$ref": "#/components/parameters/perPageQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Notes list retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotesPage"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Notes"],
        "summary": "Create a new note",
        "description": "Creates a note owned by the authenticated user.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNoteInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Note created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/notes/{noteId}": {
      "get": {
        "tags": ["Notes"],
        "summary": "Get note by ID",
        "description": "Returns a single note if it exists and is owned by the authenticated user.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/noteIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Note found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Invalid note id format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Note not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Notes"],
        "summary": "Update note",
        "description": "Updates a note owned by the authenticated user and returns the updated note. At least one field must be provided.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/noteIdPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNoteInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Note updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Invalid note id or request validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Note not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Notes"],
        "summary": "Delete note",
        "description": "Deletes a note owned by the authenticated user and returns the deleted note.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/noteIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Note deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "Invalid note id format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Note not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users/me/avatar": {
      "patch": {
        "tags": ["Users"],
        "summary": "Update user avatar",
        "description": "Uploads a new avatar image (max 2 MB, image mimetypes only) to Cloudinary and stores the resulting URL on the user.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["avatar"],
                "properties": {
                  "avatar": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file to upload (max 2 MB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Avatar updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvatarResponse"
                }
              }
            }
          },
          "400": {
            "description": "No file uploaded or the file is not an image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
